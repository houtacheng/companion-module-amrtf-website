{
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "version": "1.2.0",
    "key": "",
    "oauth2": {
        "client_id": "233345806595-69ciq75blbfiuuaqhe27jl8ii923ldk4.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.appdata"
        ]
    },
    "permissions": [
        "storage",
        "activeTab",
        "identity",
        "alarms",
        "contextMenus",
        "favicon",
        "scripting"
    ],
    "host_permissions": [
        "https://www.googleapis.com/*",
        "*://*.amrtf.org/*",
        "*://amrtf.org/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "libs/floating-ui-core.js",
                "libs/floating-ui-dom.umd.js",
                "libs/tiptap.js",
                "libs/approx-string-match.js",
                "storage-backend.js",
                "anchoring.js",
                "disclosure.js",
                "script.js",
                "visibility.js",
                "floating-ball.js",
                "live-sync.js"
            ],
            "css": [
                "libs/fonts.css",
                "highlights.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.amrtf.org/*",
                "*://amrtf.org/*"
            ],
            "js": [
                "companion-content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "sidebar.html",
                "sidebar.css",
                "sidebar.js",
                "storage-backend.js",
                "disclosure.js",
                "style.css",
                "highlights.css",
                "libs/tiptap.js",
                "libs/fonts.css",
                "libs/fonts/*",
                "images/*",
                "images/toolbar-icons/*",
                "excluded-websites.json",
                "param-whitelist.json"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "action": {
        "default_title": "大慈恩官網整合外掛",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    },
    "commands": {
        "toggle-sidebar": {
            "suggested_key": {
                "default": "Ctrl+Shift+H",
                "mac": "Command+Shift+H"
            },
            "description": "Abrir/Cerrar la barra lateral de Resaltador Quantum PRO"
        }
    }
}